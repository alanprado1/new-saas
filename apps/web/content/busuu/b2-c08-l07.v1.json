      "dialogue": {
        "context": "Two friends look at a scarf, then visit a newly opened shop to choose wine.",
        "speakerLabels": {
          "guest": "Friend choosing a gift",
          "staff": "Friend giving advice"
        },
        "speakers": [
          "guest",
          "staff"
        ],
        "japaneseVisible": false,
        "translationVisible": true,
        "turns": [
          {
            "id": "turn-1",
            "speaker": "guest",
            "japanese": "母の日に何をあげようかな。まだ決めていないんだ。",
            "reading": "ははの ひに なにを あげようかな。まだ きめていないんだ。",
            "english": "I wonder what I should give for Mother’s Day. I have not decided yet."
          },
          {
            "id": "turn-2",
            "speaker": "staff",
            "japanese": "このスカーフはどう？いろいろな服に合うし、軽いし、おすすめだよ。",
